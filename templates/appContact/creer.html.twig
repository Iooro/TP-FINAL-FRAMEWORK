
{% extends "base.html.twig" %}

{% block title %}Contact - Créer un contact{% endblock %}

{% block body %}

<div class="container-fluid mt-5">
    <div class="row justify-content-center">
        <div class="col-3">
            <div class="border rounded p-3">
                <h3 class="text-center">Créer le contact</h3>

                <form action="/ajouter" method="POST">
                    <div class="mb-3">
                        <label class="form-label" for="nom">Nom</label>
                        <input type="text" id="nom" required maxlength="65" name="nom" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="prenom">Prenom</label>
                        <input type="text" id="prenom" required maxlength="65" name="prenom" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="numero">Numero</label>
                        <input type="text" id="numero" required maxlength="65" name="numero" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="commentaire">Commentaire</label>
                        <textarea id="commentaire" name="commentaire" class="form-control" rows="5" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Valider</button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}
